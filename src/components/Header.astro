---
import { headerNav } from '../config/navigation';
---

<header class="site-header" id="siteHeader">
  <div class="header-container">
    <!-- Logo -->
    <a href="/" class="logo-link" aria-label="Metal Pro Buildings Home">
      <img
        src="https://cxm.ihg.mybluehost.me/website_e18f7bf7/wp-content/uploads/2025/08/mpb-wp-login-logo-600x325-1.webp"
        alt="Metal Pro Buildings"
        class="logo-img"
      />
    </a>

    <!-- Mobile Hamburger -->
    <button
      class="mobile-toggle"
      id="menuToggle"
      aria-label="Toggle Navigation"
      aria-expanded="false"
      aria-controls="mainNav"
    >
      <span class="bar"></span>
      <span class="bar"></span>
      <span class="bar"></span>
    </button>

    <!-- Navigation -->
    <nav class="main-nav" id="mainNav">
      <ul class="nav-list">
        {headerNav.map((item) => (
          <li
            class:list={[
              item.isMegaMenu && 'has-megamenu',
              !item.isMegaMenu && item.children && 'has-dropdown'
            ]}
          >
            <a href={item.url} class="nav-link">
              <span>{item.label}</span>
              {(item.isMegaMenu || item.children) && (
                <span class="arrow" aria-hidden="true">⌄</span>
              )}
            </a>

            <!-- Mega Menu -->
            {item.isMegaMenu && item.megaColumns && (
              <div class="megamenu-dropdown">
                <div class="megamenu-inner">
                  <div class="mega-intro">
                    <span class="mega-kicker">EXPLORE</span>
                    <h3>Built for your vision.</h3>
                    <p>
                      Explore our metal building solutions designed for
                      strength, flexibility and long-term performance.
                    </p>
                  </div>

                  <div class="megamenu-grid">
                    {item.megaColumns.map((col) => (
                      <div class="megamenu-col">
                        <h4>{col.title}</h4>
                        <ul>
                          {col.items.map((subItem) => (
                            <li>
                              <a href={subItem.url}>
                                <span>{subItem.label}</span>
                                <span class="menu-arrow">→</span>
                              </a>
                            </li>
                          ))}
                        </ul>
                      </div>
                    ))}
                  </div>
                </div>
              </div>
            )}

            <!-- Standard Dropdown -->
            {!item.isMegaMenu && item.children && (
              <div class="standard-dropdown">
                <ul class="standard-dropdown-inner">
                  {item.children.map((child) => (
                    <li>
                      <a href={child.url}>
                        <span>{child.label}</span>
                        <span class="menu-arrow">→</span>
                      </a>
                    </li>
                  ))}
                </ul>
              </div>
            )}
          </li>
        ))}
      </ul>

      <!-- Mobile CTA -->
      <div class="mobile-cta-container">
        <a href="/quote" class="cta-button mobile-cta-btn">
          <span>START MY PROJECT</span>
          <span class="cta-arrow">→</span>
        </a>
      </div>
    </nav>

    <!-- Desktop CTA -->
    <div class="desktop-cta-container">
      <a href="/quote" class="cta-button">
        <span>START MY PROJECT</span>
        <span class="cta-arrow">→</span>
      </a>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('menuToggle');
  const navMenu = document.getElementById('mainNav');
  const siteHeader = document.getElementById('siteHeader');

  /* Mobile menu toggle */
  toggleBtn?.addEventListener('click', () => {
    const isOpen = toggleBtn.classList.toggle('active');
    navMenu?.classList.toggle('active', isOpen);
    toggleBtn.setAttribute('aria-expanded', String(isOpen));
    document.body.classList.toggle('menu-open', isOpen);
  });

  /* Mobile dropdown accordion */
  document
    .querySelectorAll('.has-dropdown > .nav-link, .has-megamenu > .nav-link')
    .forEach((link) => {
      link.addEventListener('click', (event) => {
        // Evaluates dynamically on click to support window resizing/orientation changes
        if (window.innerWidth <= 1024) {
          const parent = link.parentElement;
          if (!parent) return;

          const dropdown = parent.querySelector(
            ':scope > .standard-dropdown, :scope > .megamenu-dropdown'
          );
          if (!dropdown) return;

          event.preventDefault();
          parent.classList.toggle('open');
        }
      });
    });

  /* Header scroll effect */
  window.addEventListener(
    'scroll',
    () => {
      if (window.scrollY > 20) {
        siteHeader?.classList.add('scrolled');
      } else {
        siteHeader?.classList.remove('scrolled');
      }
    },
    { passive: true }
  );
</script>

<style>
  *,
  *::before,
  *::after {
    box-sizing: border-box;
  }

  /* Lock background page scrolling when mobile menu is active */
  :global(body.menu-open) {
    overflow: hidden;
  }

  /* =========================================
     HEADER
  ========================================= */

  .site-header {
    --orange: #ff5722;
    --orange-dark: #e64a19;
    --navy: #0f172a;
    --text: #334155;
    --border: #e2e8f0;

    background: rgba(255, 255, 255, 0.96);
    border-bottom: 1px solid var(--border);

    position: sticky;
    top: 0;
    z-index: 1000;

    width: 100%;

    transition:
      background 0.35s ease,
      box-shadow 0.35s ease,
      border-color 0.35s ease;
  }

  .site-header.scrolled {
    background: rgba(255, 255, 255, 0.92);
    backdrop-filter: blur(14px);
    -webkit-backdrop-filter: blur(14px);

    border-color: rgba(226, 232, 240, 0.7);

    box-shadow: 0 8px 30px rgba(15, 23, 42, 0.08);
  }

  .header-container {
    max-width: 1280px;
    margin: 0 auto;
    padding: 0.7rem 1.5rem;
    min-height: 72px;

    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;

    position: relative;
  }

  /* =========================================
     LOGO
  ========================================= */

  .logo-link {
    display: flex;
    align-items: center;
    text-decoration: none;
    flex-shrink: 0;

    position: relative;
    z-index: 2;
  }

  .logo-img {
    height: 44px;
    width: auto;
    max-width: 190px;
    object-fit: contain;

    transition:
      transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1),
      filter 0.35s ease;
  }

  .logo-link:hover .logo-img {
    transform: scale(1.035);
  }

  /* =========================================
     DESKTOP NAV
  ========================================= */

  .main-nav {
    display: flex;
    align-items: center;
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 1.55rem;
    align-items: center;
  }

  .nav-list > li {
    position: relative;
  }

  .nav-link {
    position: relative;
    text-decoration: none;
    color: var(--navy);
    font-weight: 650;
    font-size: 0.92rem;

    padding: 0.8rem 0.1rem;
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    white-space: nowrap;

    transition:
      color 0.25s ease,
      transform 0.25s ease;
  }

  .nav-link::after {
    content: '';
    position: absolute;
    left: 0;
    bottom: 4px;
    width: 100%;
    height: 2px;
    background: var(--orange);

    transform: scaleX(0);
    transform-origin: right;
    transition: transform 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
  }

  .nav-link:hover {
    color: var(--orange);
    transform: translateY(-1px);
  }

  .nav-link:hover::after {
    transform: scaleX(1);
    transform-origin: left;
  }

  /* =========================================
     ARROW
  ========================================= */

  .arrow {
    font-size: 0.9rem;
    color: #64748b;
    transition:
      transform 0.3s ease,
      color 0.3s ease;
  }

  .has-megamenu:hover .arrow,
  .has-dropdown:hover .arrow,
  .has-megamenu.open .arrow,
  .has-dropdown.open .arrow {
    transform: rotate(180deg);
    color: var(--orange);
  }

  /* =========================================
     MEGA MENU
  ========================================= */

  .megamenu-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: 50%;
    width: min(920px, 90vw);

    transform: translate(-50%, -8px) scale(0.98);
    transform-origin: top center;

    background: #fff;
    border: 1px solid rgba(226, 232, 240, 0.9);
    border-radius: 14px;
    box-shadow: 0 25px 60px rgba(15, 23, 42, 0.14);

    padding: 1.5rem;

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transition:
      opacity 0.25s ease,
      transform 0.3s cubic-bezier(0.2, 0.8, 0.2, 1),
      visibility 0.25s ease;
  }

  .megamenu-dropdown::before {
    content: '';
    position: absolute;
    top: -12px;
    left: 0;
    width: 100%;
    height: 14px;
  }

  .has-megamenu:hover .megamenu-dropdown {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
    transform: translate(-50%, 0) scale(1);
  }

  .megamenu-inner {
    display: grid;
    grid-template-columns: 220px 1fr;
    gap: 2rem;
  }

  .mega-intro {
    padding: 0.75rem 1rem 0.75rem 0.25rem;
    border-right: 1px solid #e2e8f0;
  }

  .mega-kicker {
    color: var(--orange);
    font-size: 0.68rem;
    font-weight: 800;
    letter-spacing: 0.16em;
  }

  .mega-intro h3 {
    color: var(--navy);
    font-size: 1.25rem;
    line-height: 1.2;
    margin: 0.5rem 0 0.6rem;
  }

  .mega-intro p {
    color: #64748b;
    font-size: 0.82rem;
    line-height: 1.6;
    margin: 0;
  }

  .megamenu-grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 1rem;
  }

  .megamenu-col h4 {
    font-size: 0.86rem;
    color: var(--navy);
    margin: 0 0 0.65rem;
    font-weight: 800;
  }

  .megamenu-col ul {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .megamenu-col li {
    margin: 0;
  }

  .megamenu-col a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.5rem;
    text-decoration: none;
    color: #64748b;
    font-size: 0.8rem;
    font-weight: 500;
    padding: 0.42rem 0.5rem;
    margin-left: -0.5rem;
    border-radius: 5px;

    transition:
      color 0.2s ease,
      background 0.2s ease,
      transform 0.2s ease;
  }

  .megamenu-col a:hover {
    color: var(--orange);
    background: #fff7f3;
    transform: translateX(3px);
  }

  .menu-arrow {
    opacity: 0;
    color: var(--orange);
    transform: translateX(-5px);

    transition:
      opacity 0.2s ease,
      transform 0.2s ease;
  }

  .megamenu-col a:hover .menu-arrow,
  .standard-dropdown a:hover .menu-arrow {
    opacity: 1;
    transform: translateX(0);
  }

  /* =========================================
     STANDARD DROPDOWN
  ========================================= */

  .standard-dropdown {
    position: absolute;
    top: calc(100% + 10px);
    left: -1rem;
    min-width: 220px;

    background: #fff;
    border: 1px solid #e2e8f0;
    border-radius: 10px;
    padding: 0.5rem;
    box-shadow: 0 20px 45px rgba(15, 23, 42, 0.12);

    opacity: 0;
    visibility: hidden;
    transform: translateY(-7px) scale(0.98);

    transition:
      opacity 0.22s ease,
      transform 0.25s ease,
      visibility 0.22s ease;
  }

  .standard-dropdown-inner {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .has-dropdown:hover .standard-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateY(0) scale(1);
  }

  .standard-dropdown li {
    margin: 0;
  }

  .standard-dropdown a {
    display: flex;
    justify-content: space-between;
    align-items: center;
    text-decoration: none;
    color: #334155;
    padding: 0.65rem 0.75rem;
    border-radius: 6px;
    font-size: 0.84rem;
    font-weight: 550;

    transition:
      background 0.2s ease,
      color 0.2s ease,
      transform 0.2s ease;
  }

  .standard-dropdown a:hover {
    background: #fff7f3;
    color: var(--orange);
    transform: translateX(3px);
  }

  /* =========================================
     CTA
  ========================================= */

  .desktop-cta-container {
    flex-shrink: 0;
  }

  .cta-button {
    position: relative;
    overflow: hidden;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.65rem;

    background: linear-gradient(135deg, #ff5722, #f4511e);
    color: #fff !important;

    padding: 0.72rem 1.15rem;
    border-radius: 5px;
    font-weight: 750;
    text-decoration: none;
    font-size: 0.76rem;
    letter-spacing: 0.07em;
    white-space: nowrap;

    box-shadow: 0 5px 14px rgba(255, 87, 34, 0.2);

    transition:
      transform 0.25s ease,
      box-shadow 0.25s ease;
  }

  .cta-button::before {
    content: '';
    position: absolute;
    top: 0;
    left: -120%;
    width: 70%;
    height: 100%;
    background: linear-gradient(
      90deg,
      transparent,
      rgba(255, 255, 255, 0.35),
      transparent
    );
    transform: skewX(-20deg);
    transition: left 0.6s ease;
  }

  .cta-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 9px 25px rgba(255, 87, 34, 0.32);
  }

  .cta-button:hover::before {
    left: 140%;
  }

  .cta-arrow {
    font-size: 1rem;
    transition: transform 0.25s ease;
  }

  .cta-button:hover .cta-arrow {
    transform: translateX(4px);
  }

  /* =========================================
     MOBILE TOGGLE
  ========================================= */

  .mobile-toggle {
    display: none;
    width: 38px;
    height: 38px;
    background: transparent;
    border: 0;
    padding: 7px;
    cursor: pointer;

    flex-direction: column;
    justify-content: center;
    gap: 5px;
    border-radius: 5px;

    transition: background 0.2s ease;
  }

  .mobile-toggle:hover {
    background: #f8fafc;
  }

  .mobile-toggle .bar {
    height: 2px;
    width: 100%;
    background: var(--navy);
    border-radius: 2px;

    transition:
      transform 0.3s ease,
      opacity 0.2s ease;
  }

  .mobile-toggle.active .bar:nth-child(1) {
    transform: translateY(7px) rotate(45deg);
  }

  .mobile-toggle.active .bar:nth-child(2) {
    opacity: 0;
  }

  .mobile-toggle.active .bar:nth-child(3) {
    transform: translateY(-7px) rotate(-45deg);
  }

  .mobile-cta-container {
    display: none;
  }

  /* =========================================
     TABLET / MOBILE RESPONSIVE
  ========================================= */

  @media (max-width: 1024px) {
    .header-container {
      min-height: 68px;
      padding: 0.65rem 1.25rem;
    }

    .desktop-cta-container {
      display: none;
    }

    .mobile-toggle {
      display: flex;
    }

    .main-nav {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      width: 100%;

      display: flex;
      flex-direction: column;
      align-items: stretch;

      background: rgba(255, 255, 255, 0.98);
      backdrop-filter: blur(15px);
      -webkit-backdrop-filter: blur(15px);

      border-top: 1px solid #e2e8f0;
      box-shadow: 0 20px 40px rgba(15, 23, 42, 0.12);

      padding: 0 1.25rem 1.5rem;
      max-height: calc(100vh - 68px);
      overflow-y: auto;

      opacity: 0;
      visibility: hidden;
      transform: translateY(-10px);
      pointer-events: none;

      transition:
        opacity 0.3s ease,
        transform 0.3s ease,
        visibility 0.3s ease;
    }

    .main-nav.active {
      opacity: 1;
      visibility: visible;
      transform: translateY(0);
      pointer-events: auto;
    }

    .nav-list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      width: 100%;
    }

    .nav-list > li {
      width: 100%;
      border-bottom: 1px solid #f1f5f9;
    }

    .nav-link {
      width: 100%;
      justify-content: space-between;
      padding: 0.95rem 0.15rem;
    }

    .nav-link::after {
      display: none;
    }

    /* Mobile Dropdown Grid Accordion */
    .megamenu-dropdown,
    .standard-dropdown {
      position: static;
      width: 100%;
      transform: none;
      box-shadow: none;
      border: none;
      border-radius: 6px;
      padding: 0;
      background: #f8fafc;

      opacity: 1;
      visibility: visible;
      pointer-events: auto;

      display: grid;
      grid-template-rows: 0fr;
      overflow: hidden;

      transition: grid-template-rows 0.35s cubic-bezier(0.2, 0.8, 0.2, 1);
    }

    .megamenu-inner,
    .standard-dropdown-inner {
      min-height: 0;
    }

    .has-megamenu:hover .megamenu-dropdown,
    .has-dropdown:hover .standard-dropdown {
      transform: none;
    }

    .has-megamenu.open .megamenu-dropdown,
    .has-dropdown.open .standard-dropdown {
      grid-template-rows: 1fr;
    }

    .megamenu-inner {
      display: block;
      padding: 0 0.8rem;
    }

    .mega-intro {
      display: none;
    }

    .megamenu-grid {
      grid-template-columns: 1fr;
      gap: 0.5rem;
      padding: 0.5rem 0 0.75rem;
    }

    .megamenu-col h4 {
      text-align: left;
      border: none;
      margin: 0.5rem 0 0.25rem;
    }

    .megamenu-col li {
      text-align: left;
    }

    .megamenu-col a {
      padding: 0.5rem 0.25rem;
    }

    .standard-dropdown a {
      padding: 0.7rem 0.75rem;
    }

    .mobile-cta-container {
      display: block;
      margin-top: 1.25rem;
      width: 100%;
    }

    .mobile-cta-btn {
      width: 100%;
    }
  }

  /* =========================================
     SMALL MOBILE
  ========================================= */

  @media (max-width: 480px) {
    .header-container {
      padding: 0.6rem 1rem;
    }

    .logo-img {
      height: 39px;
      max-width: 165px;
    }

    .main-nav {
      padding: 0 1rem 1.25rem;
    }
  }

  /* =========================================
     ACCESSIBILITY
  ========================================= */

  @media (prefers-reduced-motion: reduce) {
    *,
    *::before,
    *::after {
      scroll-behavior: auto !important;
      transition-duration: 0.01ms !important;
      animation-duration: 0.01ms !important;
      animation-iteration-count: 1 !important;
    }
  }
</style>