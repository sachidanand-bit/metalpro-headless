    specs: [
      { label: 'Snow Load Rating', value: 'Up to 120 PSF' },
      { label: 'Max Clear Span', value: '150 ft (Column-Free)' },
      { label: 'Engineering', value: 'CSA-A660 Certified' },
      { label: 'Warranty', value: '50-Year Structural' },
    ],
    ctaText: 'Explore Farm Specs',
    ctaLink: '/steel-farm-building-canada-running-an-agricultural-operation',
    image: 'https://cxm.ihg.mybluehost.me/website_e18f7bf7/wp-content/uploads/2026/08/Steel-Farm.webp',
  },
  {
    id: 'residential',
