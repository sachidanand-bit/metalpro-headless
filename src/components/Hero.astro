    specs: [
      { label: 'Steel Grade', value: 'Heavy-Gauge Canadian Steel' },
      { label: 'Corrosion', value: 'Galvalume™ Protected' },
      { label: 'Stamps', value: 'Provincial P.Eng Stamped' },
      { label: 'Warranty', value: '50-Year Structural' },
    ],
    ctaText: 'Explore Industrial Specs',
    ctaLink: '/industrial-steel-building-canada-a-manufacturing-operations-guide',
