---

<section class="hero-section">
  <div class="hero-container">
    
    <!-- Top Announcement Bar -->
    <div class="hero-badge">
      <span class="flag">🇨🇦</span> 
      <span>100% Canadian Steel • Certified Provincial P.Eng Stamped Engineering</span>
    </div>

    <!-- Main Headline & Intro -->
    <div class="hero-header">
      <h1>Engineered Canadian Steel Buildings.<br /><span class="gradient-text">Built to Outlast Extreme Climates.</span></h1>
      <p class="hero-subtitle">
        We guide Canadian builders through selection, snow/wind load engineering, and stamped blueprinting for a seamless, factory-direct construction experience.
      </p>
    </div>

    <!-- Application Switcher (Interactive Dwell-Time Module) -->
    <div class="switcher-wrapper">
      <div class="switcher-tabs" role="tablist">
        {applications.map((app, index) => (
          <button
            class={`tab-btn ${index === 0 ? 'active' : ''}`}
            data-target={app.id}
            role="tab"
            aria-selected={index === 0 ? 'true' : 'false'}
          >
            {app.title}
          </button>
        ))}
      </div>

      <!-- Tab Content Panels -->
      <div class="switcher-panels">
        {applications.map((app, index) => (
          <div
            id={`panel-${app.id}`}
            class={`content-panel ${index === 0 ? 'active' : ''}`}
            role="tabpanel"
          >
            <div class="panel-grid">
              
              <!-- Left Specs & Copy Column -->
              <div class="panel-info">
                <span class="kicker">{app.tagline}</span>
                <h2>{app.title} Solutions</h2>
                <p>{app.description}</p>

                <!-- Spec Badges Grid -->
                <div class="specs-grid">
                  {app.specs.map((spec) => (
                    <div class="spec-card">
                      <span class="spec-value">{spec.value}</span>
                      <span class="spec-label">{spec.label}</span>
                    </div>
                  ))}
                </div>

                <div class="panel-actions">
                  <a href={app.ctaLink} class="primary-btn">{app.ctaText} →</a>
                  <a href="/quote" class="secondary-btn">Request Stamped Blueprint Quote</a>
                </div>
              </div>

              <!-- Right Visual Preview -->
              <div class="panel-media">
                <img src={app.image} alt={app.title} class="panel-img" />
                <div class="trust-overlay">
                  <span class="trust-icon">🛡️</span>
                  <div>
                    <strong>50-Year Guarantee</strong>
                    <small>Factory Direct Engineering</small>
                  </div>
                </div>
              </div>

            </div>
          </div>
        ))}
      </div>
    </div>

  </div>
</section>

<script>
  const tabButtons = document.querySelectorAll<HTMLButtonElement>('.tab-btn');
  const panels = document.querySelectorAll<HTMLElement>('.content-panel');

  tabButtons.forEach((btn) => {
    btn.addEventListener('click', () => {
      const targetId = btn.getAttribute('data-target');

      // Deactivate all
      tabButtons.forEach((b) => {
        b.classList.remove('active');
        b.setAttribute('aria-selected', 'false');
      });
      panels.forEach((p) => p.classList.remove('active'));

      // Activate selected
      btn.classList.add('active');
      btn.setAttribute('aria-selected', 'true');
      const activePanel = document.getElementById(`panel-${targetId}`);
      activePanel?.classList.add('active');
    });
  });
</script>

<style>
  .hero-section {
    background: linear-gradient(180deg, #0f172a 0%, #1e293b 100%);
    color: #ffffff;
    padding: 3.5rem 1.5rem 4.5rem;
    position: relative;
    overflow: hidden;
  }

  .hero-container {
    max-width: 1280px;
    margin: 0 auto;
  }

  .hero-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    background: rgba(255, 87, 34, 0.15);
    border: 1px solid rgba(255, 87, 34, 0.4);
    color: #ff7043;
    padding: 0.4rem 1rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    margin-bottom: 1.5rem;
  }

  .hero-header {
    text-align: center;
    max-width: 900px;
    margin: 0 auto 3rem;
  }

  .hero-header h1 {
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 800;
    line-height: 1.15;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .gradient-text {
    background: linear-gradient(90deg, #ff5722 0%, #ff8a65 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .hero-subtitle {
    font-size: 1.15rem;
    color: #94a3b8;
    line-height: 1.6;
    margin: 0 auto;
    max-width: 750px;
  }

  /* Switcher Container */
  .switcher-wrapper {
    background: rgba(15, 23, 42, 0.8);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 16px;
    padding: 1.5rem;
    backdrop-filter: blur(10px);
    box-shadow: 0 20px 50px rgba(0, 0, 0, 0.3);
  }

  .switcher-tabs {
