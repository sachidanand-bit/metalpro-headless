    tagline: 'Custom Garages, Sheds & Living Spaces',
    description: 'Build your dream workshop, RV garage, or barndominium shell with factory-direct Canadian steel designed for quick DIY assembly or contractor referral.',
    specs: [
      { label: 'Assembly', value: 'DIY Kit or Pro Install' },
      { label: 'Insulation Support', value: 'R-30+ Ready' },
      { label: 'Customization', value: 'Doors, Windows, Endwalls' },
      { label: 'Warranty', value: '50-Year Structural' },
    ],
    ctaText: 'Explore Residential Specs',
    ctaLink: '/steel-garage-canada-what-ownership-is-really-like',
