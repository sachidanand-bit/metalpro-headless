---
const provinces = ['Ontario', 'Alberta', 'British Columbia', 'Manitoba', 'Nova Scotia', 'Saskatchewan'];
---

<footer class="site-footer">
  <!-- Province Bar -->
  <div class="province-bar">
    <div class="footer-container">
      <h3>Proudly serving businesses and homeowners across Canada, with fast delivery to all major provinces.</h3>
      <div class="province-pills">
        {provinces.map((prov) => (
          <span class="pill">{prov}</span>
        ))}
      </div>
    </div>
  </div>

  <!-- Main Links Matrix -->
  <div class="footer-main">
    <div class="footer-container footer-grid">
      <!-- Col 1: Info & Badges -->
      <div class="footer-col brand-col">
        <h3>Providing The Best<br />Metal Buildings In The Canada</h3>
        <p>📞 (888) 296-6688</p>
        <p>✉️ hello@cxm.ihg.mybluehost.me</p>
        <p>📍 55 Commerce Valley Dr W #502 Thornhill, ON L3T 7V9</p>
        <div class="badges">
          <img src="https://cxm.ihg.mybluehost.me/website_e18f7bf7/wp-content/uploads/2026/08/cwb-badge.png" alt="CWB Certified CSA A660" />
          <img src="https://cxm.ihg.mybluehost.me/website_e18f7bf7/wp-content/uploads/2026/08/bbb-badge.png" alt="BBB Accredited Business A+" />
        </div>
      </div>

      <!-- Col 2: Building Categories -->
      <div class="footer-col">
        <h4>Buildings <span class="highlight">Application</span></h4>
        <ul>
          <li><a href="/residential">Residential</a></li>
          <li><a href="/commercial">Commercial</a></li>
          <li><a href="/industrial">Industrial</a></li>
          <li><a href="/agricultural">Agricultural</a></li>
        </ul>
        <h4 style="margin-top: 1.5rem;">Buildings <span class="highlight">Types</span></h4>
        <ul>
          <li><a href="/cfs">CFS Buildings</a></li>
          <li><a href="/quonset">Quonset Hut Buildings</a></li>
          <li><a href="/i-beam">I-Beam Steel Buildings</a></li>
          <li><a href="/building-comparison">Building Comparison</a></li>
        </ul>
      </div>

      <!-- Col 3: Links & Portal -->
      <div class="footer-col">
        <h4>Important <span class="highlight">Links</span></h4>
        <ul>
          <li><a href="/about-us">About us</a></li>
          <li><a href="/contact-us">Contact us</a></li>
          <li><a href="/financing">Financing</a></li>
          <li><a href="/brochures">Brochures</a></li>
        </ul>
        <h4 style="margin-top: 1.5rem;">Customer <span class="highlight">Portal</span></h4>
        <ul>
          <li><a href="/manuals">Building Manuals</a></li>
          <li><a href="/build-your-own">Build Your Own</a></li>
        </ul>
      </div>

      <!-- Col 4: Quick Links -->
      <div class="footer-col">
        <h4>Quick <span class="highlight">Links</span></h4>
        <ul>
          <li><a href="/faq">FAQs</a></li>
          <li><a href="/blogs">Blogs</a></li>
          <li><a href="/gallery">Gallery</a></li>
          <li><a href="/warranty">Warranty</a></li>
          <li><a href="/privacy-policy">Privacy Policy</a></li>
          <li><a href="/become-a-builder">Become A Builder</a></li>
          <li><a href="/terms-and-conditions">Terms & Conditions</a></li>
          <li><a href="/order-process">Building Order Process</a></li>
        </ul>
      </div>
    </div>
  </div>

  <!-- Copyright Bar -->
  <div class="copyright-bar">
    <div class="footer-container copyright-content">
      <p>© Copyright 2026. Metal Pro Buildings. All Rights Reserved.</p>
      <p><strong>Authorised By Pioneer Steel Manufacturing</strong></p>
    </div>
  </div>
</footer>

<style>
  .site-footer { background: #000000; color: #ffffff; font-family: system-ui, sans-serif; }
  .footer-container { max-width: 1200px; margin: 0 auto; padding: 0 1.5rem; }
  
  /* Province Bar */
  .province-bar { border-bottom: 1px solid #222; padding: 2rem 0; text-align: center; }
  .province-bar h3 { font-size: 1.25rem; font-weight: 600; margin-bottom: 1rem; line-height: 1.4; }
  .province-pills { display: flex; justify-content: center; gap: 0.75rem; flex-wrap: wrap; }
  .pill { border: 1px solid #fff; border-radius: 20px; padding: 0.4rem 1.25rem; font-size: 0.875rem; }

  /* Main Grid */
  .footer-main { padding: 3rem 0; }
  .footer-grid { display: grid; grid-template-columns: 2fr 1fr 1fr 1fr; gap: 2.5rem; }
  .footer-col h3 { font-size: 1.25rem; margin-bottom: 1rem; line-height: 1.3; }
  .footer-col h4 { font-size: 1.1rem; margin-bottom: 0.75rem; }
  .highlight { color: #38bdf8; }
  .footer-col ul { list-style: none; padding: 0; margin: 0; }
  .footer-col li { margin-bottom: 0.5rem; }
  .footer-col a { color: #94a3b8; text-decoration: none; font-size: 0.875rem; }
  .footer-col a:hover { color: #ffffff; }
  .badges { display: flex; gap: 1rem; margin-top: 1rem; flex-wrap: wrap; }
  .badges img { height: 40px; width: auto; }

  /* Copyright */
  .copyright-bar { border-top: 1px solid #222; padding: 1.25rem 0; font-size: 0.85rem; color: #94a3b8; }
  .copyright-content { display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 0.5rem; }

  /* Responsive Rules */
  @media (max-width: 900px) {
    .footer-grid { grid-template-columns: 1fr 1fr; gap: 2rem; }
    .brand-col { grid-column: span 2; }
  }

  @media (max-width: 600px) {
    .footer-grid { grid-template-columns: 1fr; }
    .brand-col { grid-column: span 1; }
    .copyright-content { flex-direction: column; text-align: center; }
  }
</style>