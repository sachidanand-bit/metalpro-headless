---
import { getAllPostSlugs, getPostBySlug, getFAQs } from '../lib/wp';
import SeoHead from '../components/SeoHead.astro';
import FaqSection from '../components/FaqSection.astro';

export async function getStaticPaths() {
  const slugs = await getAllPostSlugs();
  return slugs.map((slug) => ({
    params: { slug },
  }));
}

const { slug } = Astro.params;
const post = await getPostBySlug(slug!);

if (!post) {
  return Astro.redirect('/404');
}

const allFaqs = await getFAQs();

// Matches [faqs], curly quotes (”/“), straight quotes, HTML entities, and optional wrapping <p> tags
const shortcodeRegex = /(?:<p[^>]*>)?\s*\[faqs(?:\s+category=(?:&quot;|&#8221;|&#8220;|["'”`‘])?([a-zA-Z0-9_-]+)(?:&quot;|&#8221;|&#8220;|["'”`‘])?)?\s*\]\s*(?:<\/p>)?/i;

const rawContent = post.content || '';
const match = rawContent.match(shortcodeRegex);

let contentBefore = rawContent;
let contentAfter = '';
let categoryFaqs = [];
let hasShortcode = false;

if (match) {
  hasShortcode = true;
  const categorySlug = match[1]; // Extracts category e.g. "farm"

  const parts = rawContent.split(match[0]);
  contentBefore = parts[0];
  contentAfter = parts.slice(1).join(match[0]);

  if (categorySlug) {
    categoryFaqs = allFaqs.filter((faq) =>
      faq.faqCategories?.nodes.some(
        (cat) => cat.slug.toLowerCase() === categorySlug.toLowerCase()
      )
    );
  } else {
    categoryFaqs = allFaqs;
  }
}
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead seo={post.seo} fallbackTitle={post.title} />
  </head>
  <body style="max-width: 800px; margin: 0 auto; padding: 2rem; font-family: system-ui, sans-serif; line-height: 1.6;">
    <a href="/" style="color: #2563eb; text-decoration: none;">&larr; Back to Home</a>
    <h1 style="margin-top: 1.5rem; font-size: 2.25rem;">{post.title}</h1>
    
    {hasShortcode ? (
      <>
        <div class="post-content" set:html={contentBefore} />
        <FaqSection faqs={categoryFaqs} />
        <div class="post-content" set:html={contentAfter} />
      </>
    ) : (
      <div class="post-content" set:html={post.content} />
    )}
  </body>
</html>