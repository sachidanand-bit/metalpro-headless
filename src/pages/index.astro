---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import EngineeringMap from '../components/EngineeringMap.astro';
import BuildingStyles from '../components/BuildingStyles.astro';
import BuildingGallery from '../components/BuildingGallery.astro';
import BuilderJourney from '../components/BuilderJourney.astro';
import PanoramaGallery from '../components/PanoramaGallery.astro';
import BlogCarousel from '../components/BlogCarousel.astro';
import FaqSection from '../components/FaqSection.astro';
import { getFAQs, getPosts } from '../lib/wp';

const faqs = await getFAQs();
const posts = await getPosts();
const sampleSeo = posts[0]?.seo || null;
---

<BaseLayout seo={sampleSeo} title="Metal Pro Buildings | Steel Buildings Canada">
  <Hero />
  <EngineeringMap />
  <BuildingStyles />
  <BuildingGallery />
  <BuilderJourney />
  <PanoramaGallery />
  <BlogCarousel posts={posts} />
  <FaqSection faqs={faqs} />
</BaseLayout>