---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getFAQs, getPosts } from '../lib/wp';
import FaqSection from '../components/FaqSection.astro';

const faqs = await getFAQs();
const posts = await getPosts();
const sampleSeo = posts[0]?.seo || null;
---

<BaseLayout seo={sampleSeo} title="Metal Pro Buildings | Steel Buildings Canada">
  <div style="max-width: 1200px; margin: 0 auto; padding: 2rem 1.5rem;">
    <h1>Metal Pro Buildings</h1>

    <h2>Recent Articles</h2>
    <ul>
      {posts.map((post) => (
        <li style="margin-bottom: 0.5rem;">
          <a href={`/${post.slug}`} style="color: #2563eb; text-decoration: underline;">
            {post.title}
          </a>
        </li>
      ))}
    </ul>

    <h2>Frequently Asked Questions</h2>
    <FaqSection faqs={faqs} />
  </div>
</BaseLayout>