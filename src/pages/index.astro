---
import { getFAQs, getPosts } from '../lib/wp';
import SeoHead from '../components/SeoHead.astro';
import FaqSection from '../components/FaqSection.astro';

const faqs = await getFAQs();
const posts = await getPosts();
const sampleSeo = posts[0]?.seo || null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <SeoHead seo={sampleSeo} fallbackTitle="Metal Pro Buildings | Steel Buildings Canada" />
  </head>
  <body style="max-width: 900px; margin: 0 auto; padding: 2rem; font-family: system-ui, sans-serif;">
    <h1>Metal Pro Buildings</h1>

    <h2>Recent Articles</h2>
    <ul>
      {posts.map((post) => (
        <li style="margin-bottom: 0.5rem;">
          <a href={`/${post.slug}`} style="color: #2563eb; text-decoration: underline;">
            {post.title}
          </a>
        </li>
      ))}
    </ul>

    <h2>Frequently Asked Questions</h2>
    <FaqSection faqs={faqs} />
  </body>
</html>