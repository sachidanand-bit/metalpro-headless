---
import { getFAQs, getPosts } from '../lib/wp';
import SeoHead from '../components/SeoHead.astro';
import FaqSection from '../components/FaqSection.astro';

const faqs = await getFAQs();
const posts = await getPosts();

// For demonstration, taking the SEO from the first post loaded
const sampleSeo = posts[0]?.seo || null;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <SeoHead seo={sampleSeo} fallbackTitle="Home | Metal Pro Buildings" />
  </head>
  <body style="padding: 2rem;">
    <h1>Metalpro Headless Verification</h1>

    <h2>Recent Articles</h2>
    <ul>
      {posts.slice(0, 3).map((post) => (
        <li>{post.title}</li>
      ))}
    </ul>

    <h2>Frequently Asked Questions</h2>
    <FaqSection faqs={faqs.slice(0, 5)} />
  </body>
</html>